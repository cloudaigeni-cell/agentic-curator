# Copy to .env and fill in ONE provider. With nothing set, the offline provider is used.
CURATOR_PROVIDER=offline          # offline | anthropic | gemini | openai
# CURATOR_MODEL=
CURATOR_LIBRARY=./library
CURATOR_OUT=./runs
CURATOR_CONCURRENCY=4
CURATOR_PHOTO_DISTANCE=4          # dHash bits; <= this is "the same shot"
CURATOR_TEXT_SIMILARITY=0.80      # Jaccard; >= this is "near-identical"

# --- Anthropic ---
# ANTHROPIC_API_KEY=

# --- Google Gemini with an API key ---
# GOOGLE_API_KEY=

# --- Google Gemini with Google credentials (run: gcloud auth application-default login) ---
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# --- OpenAI, or any compatible endpoint (Ollama: http://localhost:11434/v1) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
